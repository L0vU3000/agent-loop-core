{
  "name": "agent-loop-eve-bug-fix-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Disposable spike validating Eve as a durable runtime adapter for agent-loop-core's bug-fix pipeline.",
  "scripts": {
    "test": "npm exec --yes --package=node@24 -- node --test tests/runtime-adapter.test.mjs",
    "typecheck": "npm exec --yes --package=node@24 -- node node_modules/typescript/bin/tsc --noEmit",
    "eve:info": "npm exec --yes --package=node@24 -- node node_modules/eve/bin/eve.js info",
    "eve:build": "npm exec --yes --package=node@24 -- node node_modules/eve/bin/eve.js build",
    "eve:eval": "npm exec --yes --package=node@24 -- node node_modules/eve/bin/eve.js eval bug-fix"
  },
  "dependencies": {
    "ai": "^7.0.34",
    "eve": "0.27.1",
    "just-bash": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
